{
  "expo": {
    "name": "Go'zal Ayol",
    "slug": "gozal-ayol",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,

    "scheme": "gozalayol",

    "splash": {
      "backgroundColor": "#FFF1F5",
      "resizeMode": "contain"
    },

    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uz.gozalayol.app",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },

    "android": {
      "package": "uz.gozalayol.app",
      "adaptiveIcon": { "backgroundColor": "#F4407D" },
      "edgeToEdgeEnabled": true
    },

    "plugins": ["expo-router", "expo-secure-store"],

    "experiments": { "typedRoutes": false },

    "extra": {
      "apiUrl": "https://gozalayol.uz/api"
    }
  }
}
