# ── Umumiy ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Baza ──────────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/gozal_ayol

# ── JWT ───────────────────────────────────────────────────
# Production'da: openssl rand -base64 48
JWT_ACCESS_SECRET=change_me_min_16_chars_long
JWT_REFRESH_SECRET=change_me_too_min_16_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# ── Frontend ──────────────────────────────────────────────
# Bir nechta origin bo'lsa vergul bilan: http://localhost:5173,https://gozalayol.uz
CLIENT_URL=http://localhost:5173

# ── Fayl yuklash ──────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# ── Booking dvijogi ───────────────────────────────────────
TIMEZONE=Asia/Tashkent
SLOT_STEP_MIN=15
MIN_LEAD_TIME_MIN=60
MAX_ADVANCE_DAYS=60
CANCEL_LIMIT_MIN=120
BOOKING_HOLD_MINUTES=15

# ── Seed (birinchi admin) ─────────────────────────────────
ADMIN_PHONE=+998901234567
ADMIN_PASSWORD=change_me
ADMIN_NAME=Admin

# ── Payme (5-haftada to'ldiriladi) ────────────────────────
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_KEY_TEST=
PAYME_CHECKOUT_URL=https://checkout.paycom.uz
PAYME_ACCOUNT_FIELD=booking_id
