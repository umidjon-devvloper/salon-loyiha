{
  "name": "gozal-ayol",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "pnpm --filter @gozal/api dev",
    "dev:web": "pnpm --filter @gozal/web dev",
    "build:web": "pnpm --filter @gozal/web build",
    "start:api": "pnpm --filter @gozal/api start",
    "seed": "pnpm --filter @gozal/api seed",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3"
  },
  "pnpm": {
    "overrides": {
      "zod": "^3.23.8"
    }
  }
}
